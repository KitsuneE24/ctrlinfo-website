# CTRL INFO — hébergement Apache.
#
# Ce fichier est copié tel quel dans dist/ par Vite : il se retrouve à la racine
# du site une fois déployé.

Options -Indexes
DirectoryIndex index.html

# Les sauvegardes du contenu ne sont pas servies.
<FilesMatch "\.(bak|bak\.\d+)$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Les fichiers d'assets portent une empreinte dans leur nom : cache long.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  # Le contenu change quand l'administration l'enregistre : jamais de cache.
  <FilesMatch "contenu\.json$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Une seule page existe vraiment : index.html. Chaque écran a son adresse, et
# c'est l'application qui la lit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Les fichiers et dossiers réels sont servis directement — donnees/, admin/,
  # assets/ — sinon tout finirait sur index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>
