# AuthUserFile : chemin absolu à régler au déploiement.

AuthType Basic
AuthName "Administration CTRL INFO"
AuthUserFile /CHEMIN/ABSOLU/A/REGLER/.htpasswd
Require valid-user

<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
